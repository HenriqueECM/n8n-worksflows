    {
      "parameters": {
        "jsCode": "const input = $input.first().json || {};\nconst body = input.body ?? {};\nconst dados = body.dados ?? {};\nconst conteudo = (dados.conteudo ?? '').toString().trim();\nconst aba = (body.aba ?? '').toString().trim();\nconst campo = (dados.campo ?? '').toString().trim();\n\nconst errors = [];\nif (!aba) errors.push('Campo obrigatório ausente: body.aba');\nif (!campo) errors.push('Campo obrigatório ausente: body.dados.campo');\nif (!conteudo) errors.push('Campo obrigatório ausente: body.dados.conteudo');\n\nreturn {\n  ...input,\n  body: {\n    ...body,\n    dados: {\n      ...dados,\n      conteudo,\n      campo,\n      estado_atual: dados.estado_atual ?? { dados_gerais: {} },\n    },\n  },\n  _validation: {\n    isValid: errors.length === 0,\n    errors,\n  },\n};"
      },
