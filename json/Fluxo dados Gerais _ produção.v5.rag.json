      "parameters": {
        "jsCode": "const input = $input.first().json || {};\nconst rawResponse = input.response;\n\nconst normalizeParsed = (parsed) => {\n  if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\n    return {\n      campo: parsed.campo ?? input.body?.dados?.campo ?? null,\n      conteudo: (parsed.conteudo ?? '').toString().trim() || JSON.stringify(parsed),\n      erro: parsed.erro ?? null,\n      debug: parsed.debug ?? null,\n    };\n  }\n\n  return {\n    campo: input.body?.dados?.campo ?? null,\n    conteudo: (parsed ?? '').toString().trim(),\n    erro: null,\n    debug: null,\n  };\n};\n\ntry {\n  if (rawResponse === undefined || rawResponse === null) {\n    throw new Error('A resposta da IA veio vazia');\n  }\n\n  if (typeof rawResponse === 'object') {\n    return normalizeParsed(rawResponse);\n  }\n\n  const asString = rawResponse.toString();\n  const cleanData = asString.replace(/```json|```/gi, '').replace(/<[^>]*>/g, '').trim();\n\n  if (!cleanData) {\n    throw new Error('A resposta da IA veio vazia após limpeza');\n  }\n\n  try {\n    const parsed = JSON.parse(cleanData);\n    return normalizeParsed(parsed);\n  } catch {\n    return normalizeParsed(cleanData);\n  }\n} catch (e) {\n  return {\n    campo: input.body?.dados?.campo ?? null,\n    conteudo: 'Falha ao processar resposta da IA.',\n    erro: {\n      code: 'PARSE_ERROR',\n      message: e.message,\n    },\n    debug: {\n      rawType: typeof rawResponse,\n    },\n  };\n}"
      },
