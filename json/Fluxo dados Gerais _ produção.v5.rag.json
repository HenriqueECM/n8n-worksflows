    {
      "parameters": {
        "jsCode": "const input = $input.first().json || {};\nconst campo = (input.body?.dados?.campo || '').toString().trim();\nconst conteudo = (input.body?.dados?.conteudo || '').toString();\nconst dadosGerais = input.body?.dados?.estado_atual?.dados_gerais ?? {};\nconst globalCache = this.getWorkflowStaticData('global');\nconst cacheKey = `prompt:${campo}:active`;\nconst cacheItem = globalCache[cacheKey];\n\nlet promptTemplate = input.prompt_template ?? input.body?.dados?.prompt_template ?? cacheItem?.prompt_template ?? null;\nlet promptVersion = input.prompt_version ?? input.body?.dados?.prompt_version ?? cacheItem?.prompt_version ?? null;\nlet source = cacheItem?.prompt_template ? 'cache' : 'payload';\n\nif (!promptTemplate) {\n  return {\n    ...input,\n    erro: { code: 'PROMPT_NOT_FOUND', message: `Prompt não encontrado para o campo: ${campo}` },\n    debug: { campo, cacheKey },\n  };\n}\n\nif (!cacheItem || cacheItem.prompt_template !== promptTemplate || cacheItem.prompt_version !== promptVersion) {\n  globalCache[cacheKey] = {\n    prompt_template: promptTemplate,\n    prompt_version: promptVersion ?? 1,\n    updated_at: new Date().toISOString(),\n  };\n}\n\nconst ragContext = (input.rag_context ?? '').toString().trim();\nlet renderedPrompt = promptTemplate\n  .replaceAll('{{ JSON.stringify($json.body.dados.estado_atual.dados_gerais) }}', JSON.stringify(dadosGerais))\n  .replaceAll('{ JSON.stringify($json.body.dados.estado_atual.dados_gerais) }', JSON.stringify(dadosGerais))\n  .replaceAll('{{ $json.body.dados.conteudo }}', conteudo)\n  .replaceAll('{ $json.body.dados.conteudo }', conteudo);\n\nif (ragContext) {\n  if (renderedPrompt.includes('{{RAG_CONTEXT}}')) {\n    renderedPrompt = renderedPrompt.replaceAll('{{RAG_CONTEXT}}', ragContext);\n  } else {\n    renderedPrompt = `${renderedPrompt}\\n\\n## Contexto RAG\\n${ragContext}`;\n  }\n}\n\nreturn {\n  ...input,\n  prompt: renderedPrompt,\n  prompt_version: promptVersion ?? 1,\n  cache_hit: Boolean(cacheItem?.prompt_template),\n  prompt_source: source,\n  rag_hit_count: input.rag_hit_count ?? 0,\n};"
