        "jsCode": "const input = $input.first().json || {};\nconst ragItems = input.body?.dados?.rag_items ?? [];\nconst ragContextFromPayload = (input.body?.dados?.rag_context ?? '').toString().trim();\n\nlet ragContext = ragContextFromPayload;\nif (!ragContext && Array.isArray(ragItems) && ragItems.length) {\n  ragContext = ragItems\n    .map((item, idx) => {\n      const source = item?.source ?? `fonte_${idx + 1}`;\n      const text = (item?.text ?? '').toString().trim();\n      return text ? `• [${source}] ${text}` : '';\n    })\n    .filter(Boolean)\n    .join('\\n');\n}\n\nreturn {\n  ...input,\n  rag_context: ragContext,\n  rag_hit_count: Array.isArray(ragItems) ? ragItems.length : (ragContext ? 1 : 0),\n};"
