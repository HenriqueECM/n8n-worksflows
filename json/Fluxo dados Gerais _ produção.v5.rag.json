    {
      "parameters": {
        "jsCode": "const input = $input.first().json || {};\nconst aba = (input.body?.aba ?? '').toString().trim();\nconst campo = (input.body?.dados?.campo ?? '').toString().trim();\nconst validationErrors = input._validation?.errors ?? [];\n\nlet code = 'ROUTING_ERROR';\nlet message = 'Não foi possível rotear a requisição no workflow.';\n\nif (validationErrors.length > 0) {\n  code = 'VALIDATION_ERROR';\n  message = 'Payload inválido. Corrija os campos obrigatórios e tente novamente.';\n} else if (aba && aba !== 'dados_gerais') {\n  code = 'UNSUPPORTED_ABA';\n  message = `Aba não suportada: ${aba}. Valor esperado: dados_gerais.`;\n} else if (campo) {\n  code = 'UNSUPPORTED_CAMPO';\n  message = `Campo não suportado: ${campo}.`;\n}\n\nreturn {\n  campo: campo || null,\n  conteudo: message,\n  erro: { code, message, details: validationErrors },\n  debug: { aba: aba || null, campo: campo || null },\n};"
      },
